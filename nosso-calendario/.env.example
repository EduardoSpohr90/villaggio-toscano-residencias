# Nosso Calendário — variáveis de ambiente.
# Desenvolvimento: copie para .env.local. Produção: Vercel > Project > Settings >
# Environment Variables. Nunca versione valores reais.

# OAuth do Google (Google Cloud Console > APIs e serviços > Credenciais >
# ID do cliente OAuth do tipo "Aplicativo da Web")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Quem pode entrar e qual pessoa cada conta representa (eduardo e esposa)
ALLOWED_USERS=eduardo:email-do-eduardo@gmail.com,esposa:email-da-esposa@gmail.com

# Calendário compartilhado da família (o app cria na primeira entrada)
FAMILY_CALENDAR_NAME=Família Spohr
# Opcional: ID fixo do calendário (ex.: abc123@group.calendar.google.com)
FAMILY_CALENDAR_ID=

# Opcional: nomes exibidos no app
PERSON_LABELS=eduardo:Eduardo,esposa:Esposa,casal:Casal

# Opcional: agendas individuais exibidas apenas como "Ocupado" (free/busy)
# Formato: pessoa:agenda1|agenda2,pessoa:agenda3
BUSY_SOURCES=

# Opcional: origem pública fixa (obrigatória com domínio próprio)
# Ex.: https://agenda.exemplo.com.br
APP_URL=

# Opcional (recomendado): segredo com 32+ caracteres para cifrar a sessão.
# Sem ele, a chave é derivada do GOOGLE_CLIENT_SECRET (HKDF).
SESSION_SECRET=
